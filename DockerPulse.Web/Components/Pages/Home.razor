@page "/"

@using MudBlazor
@using DockerPulse.Web.Models
@using DockerPulse.Web.Services
@using Microsoft.JSInterop

@inject DockerService DockerService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Dashboard | DockerPulse</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-space-between align-center mb-6">

        <div>
            <MudText Typo="Typo.h4" Class="mb-1">
                Docker Overview
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Monitor your Docker environment in real time.
            </MudText>
        </div>

        <MudChip T="string"
                 Color="Color.Success"
                 Variant="Variant.Outlined">
            ● Docker Connected
        </MudChip>

    </div>


    <!-- OVERVIEW CARDS -->
    <MudGrid Spacing="3">

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Total Containers
                </MudText>

                <MudText Typo="Typo.h4" Class="mt-2">
                    @ContainerList.Count
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Across Docker Engine
                </MudText>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Running Containers
                </MudText>

                <MudText Typo="Typo.h4" Color="Color.Success" Class="mt-2">
                    @RunningCount
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Currently active
                </MudText>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Stopped Containers
                </MudText>

                <MudText Typo="Typo.h4" Color="Color.Error" Class="mt-2">
                    @StoppedCount
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Currently inactive
                </MudText>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Docker Status
                </MudText>

                <MudText Typo="Typo.h5"
                         Color="@(_errorMessage == null ? Color.Success : Color.Error)"
                         Class="mt-3">

                    @(_errorMessage == null ? "Connected" : "Disconnected")

                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Docker Engine connection
                </MudText>

            </MudPaper>
        </MudItem>

    </MudGrid>


    <!-- ERROR MESSAGE -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            @_errorMessage
        </MudAlert>
    }


    <!-- PERFORMANCE CHARTS -->
    <MudGrid Class="mt-3" Spacing="3">

        <MudItem xs="12" md="6">

            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.h6">
                    CPU Performance
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Sample visualization — live metrics coming next
                </MudText>

                <div class="chart-container">

                    @foreach (var point in CpuPoints)
                    {
                        <div class="chart-column">

                            <div class="chart-bar cpu-bar"
                                 style="height: @(point.Value)%;">
                            </div>

                            <MudText Typo="Typo.caption">
                                @point.Label
                            </MudText>

                        </div>
                    }

                </div>

            </MudPaper>

        </MudItem>


        <MudItem xs="12" md="6">

            <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-card">

                <MudText Typo="Typo.h6">
                    Memory Performance
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Sample visualization — live metrics coming next
                </MudText>

                <div class="chart-container">

                    @foreach (var point in MemoryPoints)
                    {
                        <div class="chart-column">

                            <div class="chart-bar memory-bar"
                                 style="height: @(point.Value)%;">
                            </div>

                            <MudText Typo="Typo.caption">
                                @point.Label
                            </MudText>

                        </div>
                    }

                </div>

            </MudPaper>

        </MudItem>

    </MudGrid>


    <!-- CONTAINER TABLE -->
    <MudPaper Elevation="2" Class="pa-4 mt-6 rounded-lg dashboard-card">

        <div class="d-flex justify-space-between align-center mb-4">

            <div>
                <MudText Typo="Typo.h6">
                    Docker Containers
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Actual containers from your Docker Engine
                </MudText>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadContainers"
                       Disabled="_loading">

                Refresh

            </MudButton>

        </div>


        <MudTable Items="@ContainerList"
                  Hover="true"
                  Dense="true"
                  Striped="true"
                  Loading="_loading">

            <HeaderContent>

                <MudTh>Container</MudTh>
                <MudTh>Image</MudTh>
                <MudTh>State</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Ports</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>


            <RowTemplate>

                <!-- CONTAINER NAME -->
                <MudTd DataLabel="Container">

                    <MudText Typo="Typo.body2">
                        @context.Name
                    </MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(context.Id.Length > 12 ? context.Id[..12] : context.Id)
                    </MudText>

                </MudTd>


                <!-- IMAGE -->
                <MudTd DataLabel="Image">
                    @context.Image
                </MudTd>


                <!-- STATE -->
                <MudTd DataLabel="State">

                    <MudChip T="string"
                             Color="@GetStatusColor(context.State)"
                             Size="Size.Small">

                        @context.State

                    </MudChip>

                </MudTd>


                <!-- STATUS -->
                <MudTd DataLabel="Status">
                    @context.Status
                </MudTd>


                <!-- PORTS -->
                <MudTd DataLabel="Ports">
                    @(string.IsNullOrWhiteSpace(context.Ports)
                        ? "—"
                        : context.Ports)
                </MudTd>


                <!-- ACTIONS -->
                <MudTd DataLabel="Actions">

                    @if (context.State.Equals(
                        "running",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <MudTooltip Text="Stop Container">

                            <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => StopContainer(context))" />

                        </MudTooltip>

                        <MudTooltip Text="Restart Container">

                            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => RestartContainer(context))" />

                        </MudTooltip>
                    }
                    else if (context.State.Equals(
                        "exited",
                        StringComparison.OrdinalIgnoreCase)
                        || context.State.Equals(
                        "created",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <MudTooltip Text="Start Container">

                            <MudIconButton Icon="@Icons.Material.Filled.PlayCircle"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           OnClick="@(() => StartContainer(context))" />

                        </MudTooltip>
                    }

                </MudTd>

            </RowTemplate>


            <NoRecordsContent>

                <MudText Class="pa-4" Color="Color.Secondary">
                    No Docker containers found.
                </MudText>

            </NoRecordsContent>

        </MudTable>

    </MudPaper>

</MudContainer>


@code {

    // CONTAINER DATA

    private List<DockerContainer> ContainerList = new();

    private bool _loading = true;

    private string? _errorMessage;


    // SUMMARY COUNTS

    private int RunningCount =>
        ContainerList.Count(c =>
            c.State.Equals("running", StringComparison.OrdinalIgnoreCase));

    private int StoppedCount =>
        ContainerList.Count(c =>
            c.State.Equals("exited", StringComparison.OrdinalIgnoreCase));


    // INITIALIZATION

    protected override async Task OnInitializedAsync()
    {
        await LoadContainers();
    }


    // LOAD CONTAINERS

    private async Task LoadContainers()
    {
        try
        {
            _loading = true;
            _errorMessage = null;

            ContainerList = await DockerService.GetContainersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }


    // START CONTAINER

    private async Task StartContainer(DockerContainer container)
    {
        try
        {
            await DockerService.StartContainerAsync(container.Id);

            Snackbar.Add(
                $"{container.Name} started successfully!",
                Severity.Success);

            await LoadContainers();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to start {container.Name}: {ex.Message}",
                Severity.Error);
        }
    }


    // STOP CONTAINER

    private async Task StopContainer(DockerContainer container)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to stop {container.Name}?"
        );

        if (!confirmed)
            return;

        try
        {
            await DockerService.StopContainerAsync(container.Id);

            Snackbar.Add(
                $"{container.Name} stopped successfully!",
                Severity.Success);

            await LoadContainers();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to stop {container.Name}: {ex.Message}",
                Severity.Error);
        }
    }


    // RESTART CONTAINER

    private async Task RestartContainer(DockerContainer container)
    {
        try
        {
            await DockerService.RestartContainerAsync(container.Id);

            Snackbar.Add(
                $"{container.Name} restarted successfully!",
                Severity.Success);

            await LoadContainers();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to restart {container.Name}: {ex.Message}",
                Severity.Error);
        }
    }


    // STATUS COLORS

    private Color GetStatusColor(string state)
    {
        return state.ToLowerInvariant() switch
        {
            "running" => Color.Success,
            "exited" => Color.Error,
            "paused" => Color.Warning,
            "created" => Color.Info,
            _ => Color.Default
        };
    }


    // SAMPLE CHART DATA
    // We will replace this with actual Docker statistics later.

    private List<ChartPoint> CpuPoints =
    [
        new("10:00", 20),
        new("10:05", 35),
        new("10:10", 28),
        new("10:15", 45),
        new("10:20", 30),
        new("10:25", 35)
    ];

    private List<ChartPoint> MemoryPoints =
    [
        new("10:00", 40),
        new("10:05", 45),
        new("10:10", 48),
        new("10:15", 55),
        new("10:20", 58),
        new("10:25", 62)
    ];

    public record ChartPoint(string Label, double Value);

}


<style>

    .dashboard-card {
        border: 1px solid var(--mud-palette-divider);
    }

    .chart-container {
        height: 220px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 15px;
        padding: 20px 10px 0 10px;
        margin-top: 15px;
    }

    .chart-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        flex: 1;
        gap: 10px;
    }

    .chart-bar {
        width: 65%;
        min-height: 4px;
        border-radius: 6px 6px 0 0;
        transition: height 0.3s ease;
    }

    .cpu-bar {
        background: #38BDF8;
    }

    .memory-bar {
        background: #F59E0B;
    }
</style>